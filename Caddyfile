# Caddyfile — HTTPS and reverse proxy for Grail Wars.
#
# Docker Compose passes SITE_ADDRESS in from the project's .env file. It is the
# site's public hostname, with no scheme:
#
#   130.61.12.34.sslip.io   Interim, free, works with no domain: the VM's IP
#                           with .sslip.io appended resolves back to that IP,
#                           so a real certificate can still be issued.
#   grail.example.com       Once your domain's A record points at the VM.
#
# Switching between the two is a one-line .env edit plus `docker compose up -d`.
#
# Caddy fetches and renews the certificate on its own, and reverse_proxy
# forwards the WebSocket upgrade with no extra configuration — that is what
# lets Socket.IO hold one long-lived connection per player.

{$SITE_ADDRESS} {
	# The Node server sends HTML/JS/CSS uncompressed (no compression middleware),
	# so Caddy compresses them on the way out.
	encode zstd gzip

	# `app` is the other container on Docker's internal network; its port is
	# never published on the host, so all traffic arrives through here. Caddy
	# also sets X-Forwarded-For, which the server trusts exactly one hop of —
	# that is what makes per-IP rate limiting see real player addresses rather
	# than the proxy's.
	# APP_PORT follows PORT from .env (compose passes it in), so changing the
	# server's port does not silently break the proxy.
	reverse_proxy app:{$APP_PORT:3000}

	# Access logging is off by default so live socket.io traffic does not fill
	# the log. Uncomment to debug individual requests.
	# log {
	# 	output stdout
	# 	format console
	# }
}
