{
  "name": "grail-wars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grail Wars — a browser multiplayer party game: draft a Servant for every class, summon one, and watch a power-scaled war play out.",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "sim": "npm run sim -w server --",
    "oracle": "npm run oracle -w server --",
    "images": "npm run images -w server --",
    "smoke": "npm run smoke -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9"
  }
}
