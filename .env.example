# Grail Wars — environment variables
# EVERY key below is optional. With all of them blank the game runs fully:
# templated narration, wiki-based images, and generated fallback avatars.
#
# Local development:   cp .env.example .env    (every value may stay blank)
# Docker deployment:   cp .env.example .env    then set CONTACT_EMAIL and SITE_ADDRESS
#                     (and the FEEDBACK_* pair if you want the contact form to email you)

# Leave this alone for the Docker deployment. Caddy reads it too, so Caddy and
# the app stay in step, but there is no reason to move off 3000.
PORT=3000

# For local development. You do not need to change this for a deployment: the
# production Docker image forces NODE_ENV=production, which puts the server in a
# same-origin posture (no CORS allowlist, shipped CSP). Flipping this to
# production by hand is only needed when running `npm start` outside Docker.
NODE_ENV=development

# The deployed site's public hostname, with no scheme. Read only by Caddy in
# docker-compose.yml — the app itself never looks at it. Examples:
#   130.61.12.34.sslip.io   the VM's IP with .sslip.io appended: free, and it
#                           resolves to that IP, so HTTPS works before you own
#                           a domain
#   grail.example.com       your domain, once its A record points at the VM
SITE_ADDRESS=

# The public contact address: used in the User-Agent when talking to public
# wikis/APIs, and named in the README for takedown requests.
CONTACT_EMAIL=you@example.com

# Optional LLM layer. Polishes narration / extracts profiles when no wiki page exists.
# It NEVER decides who wins a fight.
LLM_PROVIDER=none            # none | gemini | groq | openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: improves movie / live-action character images.
TMDB_API_KEY=

# Optional extra image search providers.
IMAGE_SEARCH_PROVIDER=none   # none | brave | google_cse
BRAVE_SEARCH_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Site feedback form (Contact page).
# FEEDBACK_TO is the inbox messages are delivered to. Server-side only — it is
# never sent to the browser. Use a dedicated address, not your personal one.
# FEEDBACK_WEBHOOK_URL accepts any endpoint that turns a JSON POST into an
# email — a free Google Apps Script web app or a Formspree form both work.
# Without it, feedback is logged and kept in memory so the client still gets a
# clean success state, but no email is sent.
FEEDBACK_TO=you@example.com
FEEDBACK_WEBHOOK_URL=

# Optional overrides
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
